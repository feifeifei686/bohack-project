# Copy to .env; never put this key in VITE_* or frontend source.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
HOST=127.0.0.1
PORT=5199
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_CONCURRENT=2
AI_REQUESTS_PER_MINUTE=20
CORS_ORIGINS=http://127.0.0.1:5188,http://localhost:5188,http://127.0.0.1:5180,http://127.0.0.1:5190
# Required when binding beyond loopback. This is a separate local-service token.
API_ACCESS_TOKEN=
