{
  "name": "mingma-ai-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test tests/*.test.ts",
    "test:simulation": "node scripts/simulation-check.ts",
    "build": "tsc --noEmit && node scripts/generate-openapi.ts",
    "smoke:live": "node --env-file-if-exists=.env scripts/live-smoke.ts"
  },
  "dependencies": { "zod": "^4.3.0" },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^5.9.3" }
}
