{
  "info": {
    "name": "明码户型识别契约（合成图片，仅用于本地模拟）",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "真实图片通过页面选择；本集合仅用于本地依赖模拟，不评价模型准确率。"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5203"
    }
  ],
  "item": [
    {
      "name": "识别房间及家具",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/ai/floorplan",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"image\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aRXsAAAAASUVORK5CYII=\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('candidate geometry',()=>{const b=pm.response.json();pm.expect(b.data.rooms.length).to.equal(2);pm.expect(b.data.furniture.length).to.equal(1);pm.expect(b.meta.requiresHumanConfirmation).to.equal(true);});"
            ]
          }
        }
      ]
    },
    {
      "name": "拒绝外部图片地址",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/ai/floorplan",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"image\": \"http://localhost/private\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "拒绝伪造图片格式",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/ai/floorplan",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"image\": \"data:image/jpeg;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aRXsAAAAASUVORK5CYII=\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
