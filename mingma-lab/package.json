{
  "name": "mingma-design-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188 --strictPort",
    "build": "node scripts/check.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5188 --strictPort",
    "test": "node --experimental-strip-types --test versions/*/src/domain.test.ts",
    "format": "prettier --write gallery.css gallery.js index.html vite.config.ts versions/*/src/main.ts versions/*/src/style.css"
  },
  "dependencies": {
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/three": "^0.183.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
