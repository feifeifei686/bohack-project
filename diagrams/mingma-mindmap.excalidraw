dElements": null, "updated": 1, "link": null, "locked": false}, {"id": "link-text", "type": "text", "x": 92, "y": 914, "width": 536, "height": 166, "angle": 0, "strokeColor": "#233b35", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 17, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "空间与项目关联\n每个区域进入对应工程分类\n全局需求与局部需求合并、查冲突\n全局与区域共用第三层决策流程", "originalText": "空间与项目关联\n每个区域进入对应工程分类\n全局需求与局部需求合并、查冲突\n全局与区域共用第三层决策流程", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.4}, {"id": "visual", "type": "rectangle", "x": 70, "y": 1145, "width": 580, "height": 190, "angle": 0, "strokeColor": "#b6cabb", "backgroundColor": "#eaf2ec", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 17, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "visual-text", "type": "text", "x": 92, "y": 1159, "width": 536, "height": 166, "angle": 0, "strokeColor": "#233b35", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 17, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "3D 表达（补充建议）\n定位施工范围、点位和示意线路\n点击项目，高亮对应空间\n标明已确认、示意与待实测信息", "originalText": "3D 表达（补充建议）\n定位施工范围、点位和示意线路\n点击项目，高亮对应空间\n标明已确认、示意与待实测信息", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.4}, {"id": "demolition", "type": "rectangle", "x": 790, "y": 398, "width": 580, "height": 126, "angle": 0, "strokeColor": "#c6d3dc", "backgroundColor": "#f0f4f7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 17, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "demolition-text", "type": "text", "x": 812, "y": 412, "width": 536, "height": 102, "angle": 0, "strokeColor": "#233b35", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 17, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "拆改工程\n拆墙、砌墙、铲墙皮\n门窗洞口修整等", "originalText": "拆改工程\n拆墙、砌墙、铲墙皮\n门窗洞口修整等", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.4}, {"id": "utilities", "type": "rectangle", "x": 790, "y": 542, "width": 580, "height": 157, "angle": 0, "strokeColor": "#c6d3dc", "backgroundColor": "#f0f4f7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 17, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "utilities-text", "type": "text", "x": 812, "y": 556, "width": 536, "height": 133, "angle": 0, "strokeColor": "#233b35", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 17, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "水电与设备管线\n强弱电、开关插座底盒、给排水\n燃气改造（需资质）、地暖 / 暖气\n中央空调 / 新风管线", "originalText": "水电与设备管线\n强弱电、开关插座底盒、给排水\n燃气改造（需资质）、地暖 / 暖气\n中央空调 / 新风管线", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.4}, {"id": "waterproof", "type": "rectangle", "x": 790, "y": 717, "width": 580, "height": 95, "angle": 0, "strokeColor": "#c6d3dc", "backgroundColor": "#f0f4f7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 17, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "waterproof-text", "type": "text", "x": 812, "y": 731, "width": 536, "height": 71, "angle": 0, "strokeColor": "#233b35", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 17, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "防水工程\n厨卫、阳台防水与闭水试验", "originalText": "防水工程\n厨卫、阳台防水与闭水试验", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.4}, {"id": "masonry", "type": "rectangle", "x": 790, "y": 830, "width": 580, "height": 126, "angle": 0, "strokeColor": "#c6d3dc", "backgroundColor": "#f0f4f7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 17, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "masonry-text", "type": "text", "x": 812, "y": 844, "width": 536, "height": 102, "angle": 0, "strokeColor": "#233b35", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 17, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "泥瓦工程\n墙地砖铺贴、地面找平、过门石\n窗台石、包立管、砌筑等", "originalText": "泥瓦工程\n墙地砖铺贴、地面找平、过门石\n窗台石、包立管、砌筑等", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.4}, {"id": "carpentry", "type": "rectangle", "x": 790, "y": 974, "width": 580, "height": 126, "angle": 0, "strokeColor": "#c6d3dc", "backgroundColor": "#f0f4f7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 17, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "carpentry-text", "type": "text", "x": 812, "y": 988, "width": 536, "height": 102, "angle": 0, "strokeColor": "#233b35", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 17, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "木工工程\n吊顶、石膏线、隔墙、背景墙基层\n门套窗套基层、窗帘盒等", "originalText": "木工工程\n吊顶、石膏线、隔墙、背景墙基层\n门套窗套基层、窗帘盒等", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.4}, {"id": "painting", "type": "rectangle", "x": 790, "y": 1118, "width": 580, "height": 126, "angle": 0, "strokeColor": "#c6d3dc", "backgroundColor": "#f0f4f7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 17, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link":